<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark-first window theme. Compose draws everything else (light theme is chosen in Settings). -->
    <style name="Theme.Tally" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tally_background</item>
        <item name="android:colorBackground">@color/tally_background</item>
        <item name="android:colorAccent">@color/tally_red</item>
    </style>

    <!-- Fully transparent, animation-free theme for the widget trampoline activity. -->
    <style name="Theme.Tally.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
